<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Chỉ để ghi loại kết nối vào báo cáo lỗi khi người dùng xuất. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Hộp thoại chọn bàn phím / phát hiện IME khác dưới package visibility. -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>
    <!-- TxaApp: cài bộ bắt sự cố sớm nhất; kế thừa SplitCompatApplication (module on-demand Dịch). -->
    <application
        android:name="com.customkey.vietime.diag.TxaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VietIme"
        android:allowBackup="true"
        android:supportsRtl="false">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ML Kit chỉ nằm trong module on-demand :translate, nhưng manifest của module luôn gộp vào
             base ⇒ provider khởi tạo ML Kit sẽ chạy lúc mở app khi class CHƯA có (ClassNotFoundException,
             crash ngay khởi động). Gỡ provider; MlKitTranslator tự gọi MlKitContext.initializeIfNeeded. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
        <!-- Màn báo lỗi: tiến trình riêng ⇒ vẫn mở được khi tiến trình chính vừa crash. -->
        <activity
            android:name=".diag.TxaErrorScreen"
            android:process=":txa_crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.txa_crash"
            android:launchMode="singleTask" />
        <!-- Chia sẻ file báo cáo lỗi (cache/txa_export). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.txa.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/txa_file_paths" />
        </provider>
        <service
            android:name=".ime.CustomImeService"
            android:label="@string/ime_name"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
