# Mẫu cấu hình ký bản release. Chép thành  keystore.properties  (cùng thư mục) rồi điền.
# keystore.properties đã nằm trong .gitignore — KHÔNG BAO GIỜ commit mật khẩu.
#
# Dùng dấu / trong đường dẫn Windows (hoặc \).
storeFile=C:/Users/<tên-user>/keystores/txtelex-release.jks
storePassword=<mật khẩu keystore>
keyAlias=txtelex
keyPassword=<mật khẩu khoá — PKCS12 thì giống storePassword>
